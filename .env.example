# Models to pre-pull on first `make up`. Space-separated.
MODELS=qwen2.5-coder:7b

# Model name advertised to ruflo when it asks for a default.
RUFLO_DEFAULT_MODEL=qwen2.5-coder:7b

# Backend model that LiteLLM routes every Anthropic API call to.
# Format: <litellm-provider>/<ollama-model-name>
LITELLM_MODEL=ollama_chat/qwen2.5-coder:7b
